# Copy to .env.local and fill locally.
# Never commit or paste real API keys.

DEEPSEEK_API_KEY="<fill_locally>"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-reasoner"

DASHSCOPE_API_KEY="<fill_locally>"
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_MODEL="qwen-plus"

MULTI_REVIEW_API_CALLS="disabled"
MULTI_REVIEW_DRY_RUN="true"
MULTI_REVIEW_MAX_OUTPUT_TOKENS="4096"
MULTI_REVIEW_TIMEOUT_SECONDS="120"
